{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "deployment",
  "description": "Capabilities for the main PACS window only. The deployment origin is runtime-configured, so remote URLs must be broad; src/lib.rs pins main-window navigation to the configured origin. The secondary viewer is created by Rust, uses the same navigation pin, and receives no remote capability. Filesystem access remains scoped to paths that src/file_select.rs grants after a native picker selection.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://*",
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "platforms": ["windows", "linux", "macOS"],
  "permissions": [
    "core:default",

    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-is-maximized",

    "core:webview:allow-print",
    "core:webview:deny-internal-toggle-devtools",

    "dialog:allow-open",

    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",

    "os:allow-platform",
    "os:allow-version",

    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",

    "fs:allow-read-file",

    "allow-pick-dicom-files",
    "allow-pick-dicom-folder",
    "allow-collect-dicom-folder",
    "allow-release-picked-paths",
    "allow-open-viewer-window"
  ]
}
