{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axis",
  "mainBinaryName": "axis-desktop",
  "version": "0.1.0",
  "identifier": "com.axis.teleradiology.pacs",

  "build": {
    "beforeDevCommand": "pnpm --filter @axis/web dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "./splash"
  },

  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["default", "deployment"]
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Axis",
    "copyright": "Copyright (c) Axis",
    "shortDescription": "Axis teleradiology PACS client",
    "longDescription": "Windows client for the Axis teleradiology PACS. Connects to an Axis deployment and signs in with the same account the web client uses; no clinical data is stored on this machine.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  },

  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
