{
  "Name": "Axis Orthanc",
  "AccessionGenerator": "REJECT",
  "DicomAet": "ORTHANC",
  "DicomCheckCalledAet": false,
  "DicomServerEnabled": false,
  "DicomPort": 4242,
  "HttpPort": 8042,
  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db",
  "AuthenticationEnabled": ${ORTHANC_AUTH_ENABLED},
  "RegisteredUsers": {
    "${ORTHANC_USERNAME}": "${ORTHANC_PASSWORD}"
  },
  "RemoteAccessAllowed": true,
  "Plugins": [
    "/usr/local/share/orthanc/plugins/"
  ],
  "DicomWeb": {
    "Enable": true,
    "EnableQido": true,
    "EnableStow": false,
    "EnableWado": true,
    "Wado": {
      "Root": "/dicom-web"
    },
    "Stow": {
      "Root": "/dicom-web"
    },
    "Qido": {
      "Root": "/dicom-web"
    }
  },
  "PublicDatabaseConnections": 10,
  "TotalDatabaseConnections": 20
}
