# ========================================
# AXIS — Teleradiology PACS Environment
# ========================================
# Development-only template. Do not use these credentials in staging or
# production. Supply real values through per-environment secret management.

# App
NEXT_PUBLIC_APP_NAME=Axis
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# API
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT=4000

# CORS allow-list (comma-separated). Credentials cookies are only sent to these.
# Use a single '*' only WITHOUT credentials (the API will then disable cookies).
CORS_ORIGIN=http://localhost:3000

# Environment marker. Set to "production" to enable fail-fast env validation.
AXIS_ENV=development

# Database (PostgreSQL). Replace this local placeholder before first startup.
# Use an alphanumeric password here so it can be embedded in DATABASE_URL
# without URL-encoding; use a secret manager and a private DSN in production.
POSTGRES_USER=axis
POSTGRES_PASSWORD=ReplaceThisLocalPlaceholderWithARandomSecret123456
AXIS_PACS_DB=axis_pacs
AXIS_PACS_TEST_DB=axis_pacs_test
DATABASE_URL=postgresql://axis:ReplaceThisLocalPlaceholderWithARandomSecret123456@localhost:5432/axis_pacs
AXIS_PACS_DB_USER=axis

# Auth — AUTH_SECRET MUST be a random value of at least 32 chars. The API
# refuses to start when AUTH_SECRET is missing, a known default/placeholder, or
# too short (this validation runs regardless of NODE_ENV). In development a
# missing AUTH_SECRET falls back to a random per-process secret. Generate: 
#   openssl rand -base64 48
AUTH_SECRET=
SESSION_EXPIRY=3600

# Orthanc / DICOMweb
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# Internal OHIF rewrite target. Browser/viewer requests use the same-origin /ohif path.
OHIF_URL=http://localhost:3001

# ========================================
# Desktop client (apps/desktop, Tauri)
# ========================================
# The desktop window loads a running Axis deployment; it does not bundle the
# frontend. Configure where it points, in this precedence order:
#
#   1. AXIS_DESKTOP_SERVER_URL   read at launch by the shell (env var)
#   2. desktop.json              in the per-user app config dir
#      (%APPDATA%\com.axis.teleradiology.pacs\desktop.json on Windows),
#      written by the installer or by IT
#   3. this variable at COMPILE time, baked into the binary
#   4. http://localhost:3000    debug builds only
#
# A release build with none of these set stays on a splash screen explaining how
# to configure it. Accepts an origin, optionally with a port. Path prefixes,
# query strings, fragments and embedded credentials are rejected.
AXIS_DESKTOP_SERVER_URL=http://localhost:3000

# Escape hatch only. Leave EMPTY in every normal deployment: the frontend then
# calls the same origin it was served from, which is what keeps the httpOnly
# axis_session cookie (sameSite=lax) first-party and working.
#
# Setting this to an absolute cross-origin URL makes the session cookie
# third-party, which browsers refuse to send under sameSite=lax — login will
# fail. Only set it if the API is also changed to `sameSite=none; secure` and
# CORS_ORIGIN is extended, which is a backend change, not a desktop one.
NEXT_PUBLIC_DESKTOP_API_URL=

# Security headers
# Set to "1" only if an upstream proxy already sets these headers.
SECURITY_HEADERS_DISABLED=0
# Optional Content-Security-Policy. Left empty by default so OHIF framing works;
# if you enable a CSP, allow the OHIF viewer origin in frame-src.
SECURITY_HEADERS_CSP=

# Backup (Phase 7)
# Directory where backup artifacts are written (gitignored).
AXIS_BACKUP_DIR=backups
# Podman/container identifiers used by backup-ops and the backup CLI.
AXIS_POSTGRES_CONTAINER=axis-postgres
AXIS_ORTHANC_DATA_VOLUME=axis_orthanc_data
AXIS_PODMAN_BIN=podman
# Optional display identity for scheduled backup runs.
BACKUP_ACTOR=backup-cli

# Retention (Phase 7)
# Completed studies older than this many days are retention candidates.
AXIS_RETENTION_DAYS=90
# Only allow archival when at least one valid backup exists.
AXIS_RETENTION_REQUIRE_BACKUP=true

# Admin bootstrap — create-admin refuses to overwrite an existing admin unless
# FORCE_ADMIN_OVERWRITE=1.
FORCE_ADMIN_OVERWRITE=0
