# ========================================
# AXIS — Teleradiology PACS Environment
# ========================================
# This file is a TEMPLATE. Copy it to `.env` and fill in real values.
# NEVER commit real credentials or live connection strings — see SECURITY.md.

# App
NEXT_PUBLIC_APP_NAME=Axis
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# API
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_PORT=4000

# CORS allow-list (comma-separated). Credentials cookies are only sent to these.
# Use a single '*' only WITHOUT credentials (the API will then disable cookies).
CORS_ORIGIN=http://localhost:3000

# Environment marker. Set to "production" to enable fail-fast env validation.
AXIS_ENV=development

# Database (PostgreSQL). In production this MUST be a strong, private DSN.
DATABASE_URL=postgresql://axis:axis_dev@localhost:5432/axis_pacs
AXIS_PACS_DB=axis_pacs
AXIS_PACS_DB_USER=axis

# Auth — AUTH_SECRET MUST be a long, random value in production.
AUTH_SECRET=change-me-to-a-long-random-value-in-production
SESSION_EXPIRY=3600

# Orthanc / DICOMweb
ORTHANC_URL=http://localhost:8042
DICOMWEB_URL=http://localhost:8042/dicom-web
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# OHIF (viewer). Not consumed by the web app at runtime; override if proxied.
NEXT_PUBLIC_OHIF_URL=http://localhost:3001
OHIF_URL=http://localhost:3001

# Security headers
# Set to "1" only if an upstream proxy already sets these headers.
SECURITY_HEADERS_DISABLED=0
# Optional Content-Security-Policy. Left empty by default so OHIF framing works;
# if you enable a CSP, allow the OHIF viewer origin in frame-src.
SECURITY_HEADERS_CSP=

# Backup (Phase 7)
# Directory where backup artifacts are written (gitignored).
AXIS_BACKUP_DIR=backups
# Podman/container identifiers used by backup-ops and the backup CLI.
AXIS_POSTGRES_CONTAINER=axis-postgres
AXIS_ORTHANC_DATA_VOLUME=axis_orthanc_data
AXIS_PODMAN_BIN=podman
# Optional display identity for scheduled backup runs.
BACKUP_ACTOR=backup-cli

# Retention (Phase 7)
# Completed studies older than this many days are retention candidates.
AXIS_RETENTION_DAYS=90
# Only allow archival when at least one valid backup exists.
AXIS_RETENTION_REQUIRE_BACKUP=true

# Admin bootstrap — create-admin refuses to overwrite an existing admin unless
# FORCE_ADMIN_OVERWRITE=1.
FORCE_ADMIN_OVERWRITE=0

# ========================================
# OPTIONAL infrastructure (UNUSED by runtime code; documented for completeness)
# These images are defined in docker-compose but are NOT required by the app.
# ========================================

# Keycloak (OIDC) — currently not integrated; kept for future SSO work.
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=axis
KEYCLOAK_CLIENT_ID=axis-web
KEYCLOAK_CLIENT_SECRET=change-me-in-production
OIDC_ISSUER=http://localhost:8180/realms/axis
OIDC_CLIENT_ID=axis-web
OIDC_CLIENT_SECRET=change-me-in-production

# Redis — not used at runtime. Reserved for future caching/queues.
REDIS_URL=redis://localhost:6379

# RabbitMQ — not used at runtime. Reserved for future async work.
RABBITMQ_URL=amqp://axis:axis_dev@localhost:5672

# MinIO — not used at runtime. Reserved for future object store.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=axis-dicom
